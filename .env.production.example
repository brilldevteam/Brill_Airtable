# Brill Tables — production settings. Copy to .env.production on the server and fill in.
# .env.production is never committed (it's in .gitignore).

NODE_ENV=production

# The site's address (used in email links) and the port CloudPanel's Node.js site proxies to.
APP_URL=https://airtable.brillcrew.com
PORT=4000
HOST=127.0.0.1

# nginx (CloudPanel) sits in front: trust one proxy hop so visitor IPs and HTTPS are seen correctly.
TRUST_PROXY=1

# Where the data lives — OUTSIDE the code folder, so updates never touch it.
# (Replace "brill" with your CloudPanel site user's name.)
DATA_DIR=/home/brill/brill-data/pg
FILES_DIR=/home/brill/brill-data/files
BACKUP_DIR=/home/brill/brill-data/backups
BACKUP_KEEP=14
# Hour (server time) for the nightly database backup.
BACKUP_HOUR=2

# "invite": only the first account (you) can sign up; everyone else needs an invite. "open": anyone.
SIGNUPS=invite

# Email. Leave as "log" until Resend is set up (emails are then only written to the PM2 log).
MAIL_PROVIDER=log
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# MAIL_FROM=Brill Tables <no-reply@brillcrew.com>
